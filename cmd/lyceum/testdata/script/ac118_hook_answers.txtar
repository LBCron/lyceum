# AC118: given a captured pre-tool payload from each of the five harnesses, when lyceum hook pre-tool --harness <name> reads it, then a write outside the allowed paths and a shell call running lyceum approve each get that harness's deny answer, and an allowed write gets its allow answer
# Deny: hookSpecificOutput JSON for Claude Code, Codex and Command Code; {"decision":"deny",…} for the OpenCode and Pi
# shims. Allow: empty stdout, or {"decision":"allow"}. Always exit 0. OpenCode and Pi payloads carry no cwd: the hook
# runs in the repo, as their shims run it.
# stdin is the pty (ttyin -stdin) and stdout is sent to it too (/dev/tty), so both are a terminal.
# approvals.harness_prompt is deny, so no harness gets the harness-prompt route's "ask" (AC122, AC123 cover it).
cd $REPO
exec lyceum init
exec sh -c 'sed "s/harness_prompt: allow/harness_prompt: deny/" lyceum/config.yaml > c.yaml && mv c.yaml lyceum/config.yaml'
grep '^  harness_prompt: deny$' lyceum/config.yaml
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'
stdout '^Gate: spec$'

# Claude Code: a write of src/x.ts is denied.
payload claude/write.json $WORK/p.json /repo/note.txt=/repo/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\. [^"]*(\\"[^"]*)*"\}\}$'
! stderr .

# Claude Code: a shell call running lyceum approve is denied.
payload claude/shell.json $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this command: [^"]*(\\"[^"]*)*"\}\}$'
! stderr .

# Claude Code: the captured write, note.txt, is not code and is allowed.
payload claude/write.json $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
! stdout .
! stderr .

# Claude Code: a write under lyceum/ is allowed.
payload claude/write.json $WORK/p.json /repo/note.txt=/repo/lyceum/spec/export.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
! stdout .
! stderr .

# Claude Code: a write outside the repo is allowed.
payload claude/write.json $WORK/p.json /repo/note.txt=/outside/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
! stdout .
! stderr .

# Codex: a write of src/x.ts is denied.
payload codex/write.json $WORK/p.json /repo/src/a.txt=/repo/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness codex
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\. [^"]*(\\"[^"]*)*"\}\}$'
! stderr .

# Codex: a shell call running lyceum approve is denied.
payload codex/shell.json $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness codex
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this command: [^"]*(\\"[^"]*)*"\}\}$'
! stderr .

# Codex: the captured write, src/a.txt, is not code and is allowed.
payload codex/write.json $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness codex
! stdout .
! stderr .

# Codex: a write under lyceum/ is allowed.
payload codex/write.json $WORK/p.json /repo/src/a.txt=/repo/lyceum/spec/export.ts
stdin $WORK/p.json
