stdout '^\{"decision":"deny","reason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\. [^"]*(\\"[^"]*)*"\}$'
! stderr .

# OpenCode: a shell call running lyceum approve is denied.
