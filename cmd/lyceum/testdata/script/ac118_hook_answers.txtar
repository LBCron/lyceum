stdout '^\{"decision":"allow"\}$'
! stderr .

# The owner approves spec: the code gate is cleared.
ttyin -stdin $WORK/spec.txt
exec sh -c 'lyceum approve spec >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
grep '^gate: build$' lyceum/plan/6ae678-csv-export.md

# Claude Code: src/x.ts is allowed once spec is approved.
payload claude/write.json $WORK/p.json /repo/note.txt=/repo/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
! stdout .
! stderr .

# Claude Code: lyceum approve is still denied.
payload claude/shell.json $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness claude
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this command: [^"]*(\\"[^"]*)*"\}\}$'
