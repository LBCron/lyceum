# AC60: given TESTING.md edited after approval, when the suite passes, then no gate clears and the output names approve testing
cd $REPO
exec lyceum init
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/a_test.sh a_test.sh
exec git add -A
exec git commit -q -m 'setup'
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

# A feat at build whose plan adds no ACs: only the edited TESTING.md stands between a passing run and verify.
exec lyceum add feat 'CSV export'
linesub lyceum/plan/6ae678-csv-export.md $WORK/plan.md 'approvals: []' 'acs: []\napprovals: []'
cp $WORK/plan.md lyceum/plan/6ae678-csv-export.md
ttyin -stdin $WORK/spec.txt
exec sh -c 'lyceum approve spec >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
grep '^gate: build$' lyceum/plan/6ae678-csv-export.md

# TESTING.md edited after its approval, and committed: the tree is clean.
cp $WORK/TESTING2.md TESTING.md
exec git commit -q -am 'edit TESTING.md'
exec lyceum test
stdout '^Passed: sh ./t.sh exited 0 after \S+$'
stdout '^This run can''t clear a gate: TESTING.md changed since its approval$'
stdout '^Next: run "lyceum approve testing" yourself in a terminal$'
! grep gate-clear lyceum/events.jsonl
grep '^gate: build$' lyceum/plan/6ae678-csv-export.md

exec lyceum test --json
jsonobject
stdout '"next":"run \\"lyceum approve testing\\" yourself in a terminal"'
! grep gate-clear lyceum/events.jsonl

# Re-approved, the same passing suite clears verify.
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
exec lyceum test
! stdout 'can''t clear a gate'
stdout '^Cleared verify for 6ae678-csv-export$'
grep '^gate: close$' lyceum/plan/6ae678-csv-export.md

-- testing.txt --
testing
-- spec.txt --
spec
-- t.sh --
echo t.sh ran
-- a_test.sh --
# a test
-- TESTING.md --
---
lyceum: 1
suite: sh ./t.sh
test_files: ["**/*_test.sh"]
---

# TESTING.md
-- TESTING2.md --
---
lyceum: 1
suite: sh ./t.sh
test_files: ["**/*_test.sh"]
---

# TESTING.md

Edited after the approval.
