      lyceum/plan/6ae678-csv-export.md: sha256:91ef6d8bede74e0b232062b04a4590c49cbeca011eb8fe3334e3f8d0337312c6
      lyceum/spec/orders.md: sha256:9509ba151a38f99f515f204d06a51ab513a72a3b6f6def4870f0c2ebc011b7e4
    commit: @COMMIT@
    by: owner@example.com
    at: 2026-01-01T00:00:00Z
