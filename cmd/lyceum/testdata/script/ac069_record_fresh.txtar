# AC69: given a record whose cited file is unchanged, when freshness is computed, then the state is fresh
cd $REPO
exec lyceum init
mkdir src lyceum/understand
cp $WORK/a.ts src/a.ts
cp $WORK/b.ts src/b.ts
exec git add -A
exec git commit -q -m 'lyceum init and code'
cp $WORK/record.md lyceum/understand/payments.md
exec lyceum record lyceum/understand/payments.md
stdout '^Recorded lyceum/understand/6ae678-payments.md$'
exec lyceum status
stdout '^Records: 1 fresh, 0 drifted, 0 broken$'

# Other files change and are committed; ignored files come and go: still fresh, and only counted.
cp $WORK/readme.md README.md
exec sh -c 'echo "*.log" >> .gitignore'
cp $WORK/b.ts src/build.log
exec git add README.md .gitignore
exec git commit -q -m 'readme'
exec lyceum status
stdout '^Records: 1 fresh, 0 drifted, 0 broken$'
! stdout '^  (drifted|broken|invalid) '
exec lyceum status --json
stdout '"records":\[\],"records_fresh":1'

-- a.ts --
export const a = 1
-- b.ts --
export const b = 2
-- record.md --
---
kind: understand
title: Payments
cites:
  - path: src/a.ts
  - path: src/
---
-- readme.md --
# App
