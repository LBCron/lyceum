# AC24: given a refactor at baseline, when the full suite fails on the start commit, then baseline does not clear
cd $REPO
exec lyceum init
mkdir src
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/calc.sh src/calc.sh
cp $WORK/calc_test.sh src/calc_test.sh
exec git add -A
exec git commit -q -m 'setup'
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
exec lyceum refactor 'Tidy'
ttyin -stdin $WORK/intent.txt
exec sh -c 'lyceum approve intent >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

cp $WORK/broken.sh src/calc.sh
exec git commit -q -am 'the suite fails here, before the refactor'
! exec lyceum test
stderr 'Can''t pass the suite'
stderr '^Next: or, for a new failure, start a bug: lyceum add bug "<title>"$'
! grep '"type":"gate-clear"' lyceum/events.jsonl
grep '^gate: baseline$' lyceum/plan/6ae678-tidy.md

-- testing.txt --
testing
-- intent.txt --
intent
-- plan.txt --
plan
-- t.sh --
for f in src/*_test.sh; do sh "$f" || exit 1; done
-- calc.sh --
add() { echo $(($1 + $2)); }
-- calc-tidy.sh --
add() {
	echo $(($1 + $2))
}
-- calc_test.sh --
# TestAdd
. ./src/calc.sh
[ "$(add 1 2)" = 3 ] || { echo "--- FAIL: TestAdd"; exit 1; }
-- broken.sh --
add() { echo 0; }
-- TESTING.md --
---
lyceum: 1
suite: sh ./t.sh
test_files: ["**/*_test.sh"]
subsets:
  changed: sh ./t.sh
---

# TESTING.md
