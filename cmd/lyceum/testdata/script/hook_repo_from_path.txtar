# a payload without cwd finds the repo from the first absolute path in the call, not from the hook's own
# working directory, which may be a long-running harness server's outside the repo.
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'
stdout '^Gate: spec$'

# The hook runs outside the repo; src/ does not exist yet.
mkdir $WORK/outside
cd $WORK/outside

# OpenCode: no cwd.
payload opencode/write.json $WORK/p.json /repo/note.txt=/repo/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness opencode
stdout '^\{"decision":"deny","reason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\.'
! stderr .

# Pi: no cwd.
payload pi/write.json $WORK/p.json /repo/note.txt=/repo/src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness pi
stdout '^\{"decision":"deny","reason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\.'
! stderr .

# Codex: its cwd removed.
payload codex/write.json $WORK/p.json '"cwd": "/repo",=' /repo/src/a.txt=/repo/src/x.ts
! grep cwd $WORK/p.json
stdin $WORK/p.json
exec lyceum hook pre-tool --harness codex
stdout '^\{"hookSpecificOutput":\{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\.'
! stderr .

# OpenCode with the cwd its shim sends (ctx.location.directory) and a relative path: the repo comes from cwd.
payload opencode/write.json $WORK/p.json '"tool": "write",="tool": "write", "cwd": "/repo",' /repo/note.txt=src/x.ts
stdin $WORK/p.json
exec lyceum hook pre-tool --harness opencode
stdout '^\{"decision":"deny","reason":"Lyceum blocked this write: src/x\.ts is code, and unit 6ae678-csv-export has not cleared its spec gate\.'
! stderr .
