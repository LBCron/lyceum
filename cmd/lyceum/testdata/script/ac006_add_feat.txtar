# AC6: add feat "CSV export" writes lyceum/plan/<6 hex>-csv-export.md and checks out feat/<6 hex>-csv-export
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'

exec lyceum add feat 'CSV export'
! stderr .
stdout '^Created lyceum/plan/[0-9a-f]{6}-csv-export\.md$'
stdout '^Created branch feat/[0-9a-f]{6}-csv-export from main$'
stdout '^Unit: [0-9a-f]{6}-csv-export$'
stdout '^Gate: spec$'
# AC5 shape: the last line is the next action.
stdout '\nNext: draft the plan in lyceum/plan/[0-9a-f]{6}-csv-export\.md\n$'

exec git branch --show-current
stdout '^feat/[0-9a-f]{6}-csv-export$'
exec git ls-files lyceum/plan
stdout -count=1 '^lyceum/plan/[0-9a-f]{6}-csv-export\.md$'
exec git log -1 --format=%s
stdout '^lyceum: add feat [0-9a-f]{6}-csv-export$'
# The plan and the event are committed; nothing is left over.
exec git status --porcelain
! stdout .

# With --json the ending is one JSON object naming the plan and the branch.
exec git init -q -b main $WORK/j
exec git -C $WORK/j config user.email owner@example.com
exec git -C $WORK/j config user.name 'Test Owner'
cd $WORK/j
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export' --json
jsonobject
! stderr .
stdout '^\{"ok":true,"unit":"[0-9a-f]{6}-csv-export","gate":"spec","next":"draft the plan in lyceum/plan/[0-9a-f]{6}-csv-export\.md","data":\{"plan":"lyceum/plan/[0-9a-f]{6}-csv-export\.md","branch":"feat/[0-9a-f]{6}-csv-export","base":"main"\}\}$'
