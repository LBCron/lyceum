# AC175: given a feat at build with spec approved, when the agent adds a file to files: and commits, then check --ci has no approval-integrity finding and the scope warning clears; when another agent-written key changes, then it still names the spec approval
# stdin is the pty (ttyin -stdin) and stdout is sent to it too (/dev/tty), so both are a terminal.
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'
linesub lyceum/plan/6ae678-csv-export.md lyceum/plan/6ae678-csv-export.md 'gate: spec' 'gate: spec\nfiles: [main.go]'
exec git add -A
exec git commit -q -m 'plan'
ttyin -stdin $WORK/spec.txt
exec sh -c 'lyceum approve spec >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

# A file the build needs, outside files:: a scope warning.
cp $WORK/a.go header.go
exec git add -A
exec git commit -q -m 'a shared header'
exec lyceum check --ci
stdout '^warn: scope: .*header\.go$'

# Added to files:: no drift, and the warning clears.
linesub lyceum/plan/6ae678-csv-export.md lyceum/plan/6ae678-csv-export.md 'files: [main.go]' 'files: [main.go, header.go]'
exec git add -A
exec git commit -q -m 'add the file to the plan'
exec lyceum check --ci
stdout '^No findings$'

# acs: still counts as the plan.
linesub lyceum/plan/6ae678-csv-export.md lyceum/plan/6ae678-csv-export.md 'files: [main.go, header.go]' 'files: [main.go, header.go]\nacs: [AC1]'
exec sh -c 'lyceum check --ci; echo "exit=$?"'
stdout '^exit=2$'
stderr 'approval-integrity: the spec approval no longer matches lyceum/plan/6ae678-csv-export.md'

-- spec.txt --
spec
-- a.go --
package main
