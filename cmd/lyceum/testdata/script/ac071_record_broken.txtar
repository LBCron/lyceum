# AC71: given a record citing src/a.ts, when it is deleted or renamed, then the state is broken
cd $REPO
exec lyceum init
mkdir src lyceum/understand
cp $WORK/a.ts src/a.ts
cp $WORK/b.ts src/b.ts
exec git add -A
exec git commit -q -m 'lyceum init and code'
cp $WORK/record.md lyceum/understand/payments.md
exec lyceum record lyceum/understand/payments.md
stdout '^Recorded lyceum/understand/6ae678-payments.md$'
exec lyceum status
stdout '^Records: 1 fresh, 0 drifted, 0 broken$'

# Deleted.
rm src/a.ts
exec lyceum status
stdout '^Records: 0 fresh, 0 drifted, 1 broken$'
stdout '^  broken lyceum/understand/6ae678-payments.md: missing src/a.ts$'

# Renamed.
exec git checkout -- src/a.ts
exec lyceum status
stdout '^Records: 1 fresh, 0 drifted, 0 broken$'
exec git mv src/a.ts src/payments.ts
exec git commit -q -m 'rename'
exec lyceum status
stdout '^  broken lyceum/understand/6ae678-payments.md: missing src/a.ts$'

-- a.ts --
export const a = 1
-- b.ts --
export const b = 2
-- record.md --
---
kind: understand
title: Payments
cites:
  - path: src/a.ts
---
