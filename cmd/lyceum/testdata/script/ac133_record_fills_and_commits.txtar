kind: trace
title: Request flow
cites:
  - path: src/pay/service.ts
  - path: src/pay/gone.ts
---
-- both.md --
---
kind: trace
title: Request flow
cites:
  - path: src/pay/
    blob: "1"
    tree: "2"
---
-- outside.md --
