# End to end: a feat from add to verify through the CLI. init, approve testing, add feat, approve spec,
# code and a test mapping the plan's AC, then lyceum test clears build and verify.
cd $REPO
exec lyceum init
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/existing_test.sh existing_test.sh
exec git add -A
exec git commit -q -m 'setup'
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

exec lyceum add feat 'CSV export'
grep '^gate: spec$' lyceum/plan/6ae678-csv-export.md
grep '^status: planned$' lyceum/plan/6ae678-csv-export.md
linesub lyceum/plan/6ae678-csv-export.md $WORK/plan.md 'approvals: []' 'acs: [AC900]\napprovals: []'
cp $WORK/plan.md lyceum/plan/6ae678-csv-export.md
ttyin -stdin $WORK/spec.txt
exec sh -c 'lyceum approve spec >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
grep '^gate: build$' lyceum/plan/6ae678-csv-export.md
grep '^status: in-progress$' lyceum/plan/6ae678-csv-export.md

# The build: code and a test that maps AC900, committed.
mkdir src
cp $WORK/export.sh src/export.sh
cp $WORK/export_test.sh export_test.sh
exec git add -A
exec git commit -q -m 'CSV export'

exec lyceum test
stdout '^export ok$'
stdout '^Passed: sh ./t.sh exited 0 after \S+$'
stdout '^Cleared verify for 6ae678-csv-export$'
stdout '^Gate: close$'
grep '^gate: close$' lyceum/plan/6ae678-csv-export.md
grep '^status: implemented$' lyceum/plan/6ae678-csv-export.md

# The log: approve (testing), add, approve (spec), gate-clear.
exec sh -c 'sed "s/.*\"type\":\"\([a-z-]*\)\".*\"gate\":\"\([a-z]*\)\".*/\1 \2/" lyceum/events.jsonl'
cmp stdout $WORK/want-events.txt

# check replays the log to the same plan: no failing finding.
exec lyceum check --ci
! stdout '^fail:'

-- testing.txt --
testing
-- spec.txt --
spec
-- t.sh --
for f in *_test.sh; do sh "$f"; done
-- existing_test.sh --
# an existing test
-- export.sh --
echo "id,total"
-- export_test.sh --
# TestExport_AC900: the export prints a CSV header
sh src/export.sh | grep -q '^id,total$' && echo export ok
-- want-events.txt --
approve testing
add spec
approve spec
gate-clear verify
-- TESTING.md --
---
lyceum: 1
suite: sh ./t.sh
test_files: ["**/*_test.sh"]
---

# TESTING.md
