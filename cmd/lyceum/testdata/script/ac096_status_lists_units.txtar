# AC96: given two open units, one on the current branch and one on another branch, status lists both with their gates and branches
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'
exec git switch -q main
exec lyceum add doc 'Guide'

# Both units, each with its branch and gate; the checked-out branch's unit is marked and ends the output.
exec lyceum status
cmp stdout $WORK/want-two.txt
! stderr .

# status reads and writes nothing.
exec git status --porcelain
! stdout .

# Plans on other branches are read with one ls-tree per branch and one cat-file for all of them.
env GIT_TRACE=$WORK/trace.txt
exec lyceum status
env GIT_TRACE=
grep -count=1 'built-in: git for-each-ref' $WORK/trace.txt
grep -count=2 'built-in: git ls-tree' $WORK/trace.txt
grep 'built-in: git ls-tree -z refs/heads/main -- lyceum/plan/$' $WORK/trace.txt
grep 'built-in: git ls-tree -z refs/heads/feat/6ae678-csv-export -- lyceum/plan/$' $WORK/trace.txt
! grep 'ls-tree -z refs/heads/docs/3f4fbd-guide' $WORK/trace.txt
grep -count=1 'built-in: git cat-file --batch' $WORK/trace.txt

# A closed unit on another branch is hidden unless --all.
exec git switch -q main
exec lyceum add bug 'Old crash'
stdout '^Unit: e91b6e-old-crash$'
exec sh -c 'sed -e "s/^status: .*/status: closed/" -e "s/^gate: .*/gate: close/" lyceum/plan/e91b6e-old-crash.md > plan.tmp && mv plan.tmp lyceum/plan/e91b6e-old-crash.md'
exec git commit -q -am 'closed by hand'
exec git switch -q docs/3f4fbd-guide
exec lyceum status
! stdout e91b6e
stdout -count=2 '^ *[*]? +[0-9a-f]{6}-'
exec lyceum status --all
stdout '^   e91b6e-old-crash +bug +fix/e91b6e-old-crash +closed +close +close +nothing: the unit is closed$'
stdout -count=3 '^ *[*]? +[0-9a-f]{6}-'

# Remote-tracking branches are read too. A unit on several branches is listed once: its
# local branch wins over the remote-tracking copy.
exec git init -q --bare $WORK/remote.git
exec git remote add origin $WORK/remote.git
exec git push -q origin feat/6ae678-csv-export docs/3f4fbd-guide
exec git switch -q feat/6ae678-csv-export
cp $WORK/csv-build.md lyceum/plan/6ae678-csv-export.md
exec git commit -q -am 'build by hand'
exec git switch -q docs/3f4fbd-guide
exec lyceum status
stdout -count=1 '^[ *] +6ae678-csv-export '
stdout '^   6ae678-csv-export +feat +feat/6ae678-csv-export +in-progress +build +spec +finish the build work described in the plan$'

# With the local branch gone, the remote-tracking copy is the unit's.
exec git branch -q -D feat/6ae678-csv-export
exec lyceum status
stdout -count=1 '^[ *] +6ae678-csv-export '
stdout '^   6ae678-csv-export +feat +feat/6ae678-csv-export +planned +spec +- +run "lyceum approve spec" yourself in a terminal$'

# The checkout wins over every branch, its own remote-tracking copy included, uncommitted edits and all.
exec sh -c 'sed "s/^gate: draft$/gate: verify/" lyceum/plan/3f4fbd-guide.md > plan.tmp && mv plan.tmp lyceum/plan/3f4fbd-guide.md'
exec lyceum status
stdout -count=1 '^[ *] +3f4fbd-guide '
stdout '^\*  3f4fbd-guide +doc +docs/3f4fbd-guide +in-progress +verify +draft +run "lyceum test"$'
stdout '^Gate: verify$'

# On a branch with no unit, nothing is marked; on this greenfield repo the next action is the project interview.
exec git checkout -q lyceum/plan/3f4fbd-guide.md
exec git switch -q main
exec lyceum status
! stdout '^\*'
stdout -count=2 '^   [0-9a-f]{6}-'
! stdout '^Unit:'
stdout '^Next: finish the project interview with your agent''s lyceum-init skill, then run "lyceum approve project" yourself in a terminal$'

-- want-two.txt --
   UNIT               TYPE  BRANCH                  STATUS       GATE   LAST CLEARED  NEXT
*  3f4fbd-guide       doc   docs/3f4fbd-guide       in-progress  draft  -             finish the draft work described in the plan
   6ae678-csv-export  feat  feat/6ae678-csv-export  planned      spec   -             run "lyceum approve spec" yourself in a terminal
Pending approvals: none
Repo gates:
  project: pending, the project interview has not finished
Unit: 3f4fbd-guide
Gate: draft
Next: finish the draft work described in the plan
-- csv-build.md --
---
id: 6ae678-csv-export
type: feat
title: CSV export
branch: feat/6ae678-csv-export
status: in-progress
gate: build
approvals: []
---

## What and why
