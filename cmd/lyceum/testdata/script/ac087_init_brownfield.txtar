# AC87: given init in a repo with package.json and src/, then it reports brownfield and offers understand
cd $REPO
mkdir src
cp $WORK/package.json package.json
cp $WORK/index.js src/index.js
exec lyceum init
stdout '^Brownfield: this repo already has code \(package\.json\)\. Lyceum offers "lyceum understand" for a baseline of it; the spec then grows with each area a unit touches$'
stdout '\nNext: commit these files: git add -A && git commit -m "lyceum init", then lyceum add feat "<title>"\n$'
exec lyceum init --json
jsonobject
stdout '"brownfield":true'

# Committed code counts too, and a manifest in a subfolder (go.mod here).
exec git init -q -b main $WORK/go
exec git -C $WORK/go config user.email owner@example.com
exec git -C $WORK/go config user.name "Test Owner"
cd $WORK/go
mkdir svc
cp $WORK/go.mod svc/go.mod
cp $WORK/main.go svc/main.go
exec git add -A
exec git commit -q -m code
exec lyceum init
stdout '^Brownfield: this repo already has code \(svc/go\.mod\)\. '

# A manifest with no source beside it, source with no manifest, or only docs: greenfield.
exec git init -q -b main $WORK/manifest
exec git -C $WORK/manifest config user.email owner@example.com
exec git -C $WORK/manifest config user.name "Test Owner"
cd $WORK/manifest
cp $WORK/package.json package.json
cp $WORK/package.json package-lock.json
mkdir .github
cp $WORK/index.js .github/x.js
cp $WORK/index.js .eslintrc.js
exec lyceum init --json
stdout '"brownfield":false'
! stdout 'lyceum understand'

exec git init -q -b main $WORK/nomanifest
exec git -C $WORK/nomanifest config user.email owner@example.com
exec git -C $WORK/nomanifest config user.name "Test Owner"
cd $WORK/nomanifest
cp $WORK/index.js index.js
exec lyceum init
! stdout 'Brownfield'

# Ignored files are not source.
exec git init -q -b main $WORK/ignored
exec git -C $WORK/ignored config user.email owner@example.com
exec git -C $WORK/ignored config user.name "Test Owner"
cd $WORK/ignored
cp $WORK/package.json package.json
cp $WORK/ignore .gitignore
mkdir dist
cp $WORK/index.js dist/index.js
cp $WORK/index.js README.md
exec lyceum init
! stdout 'Brownfield'

-- package.json --
{"name": "app"}
-- index.js --
console.log("hi");
-- go.mod --
module example.com/svc
-- main.go --
package main
-- ignore --
dist/
