# AC129: given a doc unit whose branch diff touches a code file, when lyceum test passes, then verify does not clear and names the file
# stdin is the pty (ttyin -stdin) and stdout is sent to it too (/dev/tty), so both are a terminal.
cd $REPO
exec lyceum init
mkdir src
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/calc.sh src/calc.sh
cp $WORK/calc_test.sh src/calc_test.sh
exec git add -A
exec git commit -q -m 'setup'
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
exec lyceum add doc 'Calc guide'
grep '^gate: draft$' lyceum/plan/6ae678-calc-guide.md

# The doc and a code change: the suite passes, but verify does not clear, naming the code file.
mkdir docs
cp $WORK/guide.md docs/calc.md
cp $WORK/calc-v2.sh src/calc.sh
exec git add -A
exec git commit -q -m 'guide and a code change'
exec lyceum test
stdout '^Not cleared: verify: the branch changes code, and a doc unit changes only non-code files: src/calc.sh$'
stdout '^Gate: draft$'
stdout '^Next: take those changes off this branch, keeping only docs and other non-code files, then run "lyceum test"$'
! grep '"type":"gate-clear"' lyceum/events.jsonl

# A test file is code too.
exec git checkout -q main -- src/calc.sh
cp $WORK/more_test.sh src/more_test.sh
exec git add -A
exec git commit -q -m 'drop the code change, add a test'
exec lyceum test
stdout '^Not cleared: verify: the branch changes code, and a doc unit changes only non-code files: src/more_test.sh$'

# Only non-code files: verify clears.
exec git rm -q src/more_test.sh
exec git commit -q -m 'docs only'
exec lyceum test
stdout '^Cleared verify for 6ae678-calc-guide$'
stdout '^Gate: close$'
grep -count=1 '"type":"gate-clear","unit":"6ae678-calc-guide",.*"gate":"verify"' lyceum/events.jsonl
grep '^status: implemented$' lyceum/plan/6ae678-calc-guide.md

-- testing.txt --
testing
-- t.sh --
for f in src/*_test.sh; do sh "$f" || exit 1; done
-- calc.sh --
add() { echo $(($1 + $2)); }
-- calc-v2.sh --
add() { echo $(( $1 + $2 )); }
-- calc_test.sh --
# TestAdd
. ./src/calc.sh
[ "$(add 1 2)" = 3 ] || { echo "--- FAIL: TestAdd"; exit 1; }
-- more_test.sh --
# TestAddMore
. ./src/calc.sh
[ "$(add 2 2)" = 4 ] || { echo "--- FAIL: TestAddMore"; exit 1; }
-- guide.md --
# Calc

Run sh ./t.sh to test it.
-- TESTING.md --
---
lyceum: 1
suite: sh ./t.sh
single: sh ./src/{name}.sh
test_files: ["**/*_test.sh"]
---

# TESTING.md
