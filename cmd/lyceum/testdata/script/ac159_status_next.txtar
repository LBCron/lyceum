# AC159: given a feat at build with TESTING.md unapproved, when status runs, then Next: names lyceum approve testing; given a unit at close, then Next: is lyceum close
# stdin is the pty (ttyin -stdin) and stdout is sent to it too (/dev/tty), so both are a terminal.
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'

# At spec the judgment gate comes first, and verify does not rely on TESTING.md yet.
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/a_test.sh a_test.sh
exec git add -A
exec git commit -q -m 'test setup'
exec lyceum status
stdout '^Next: run "lyceum approve spec" yourself in a terminal$'

ttyin -stdin $WORK/spec.txt
exec sh -c 'lyceum approve spec >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

# At build, the verify gate relies on the unapproved TESTING.md.
exec lyceum status
stdout '^Gate: build$'
stdout '^Next: run "lyceum approve testing" yourself in a terminal$'

ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
exec lyceum status
stdout '^Next: finish the build work described in the plan$'

# At close, the next step is lyceum close.
exec sh -c 'sed -e "s/^gate: .*/gate: close/" lyceum/plan/*.md > plan.tmp && mv plan.tmp lyceum/plan/6ae678-csv-export.md'
exec lyceum status
stdout '^Gate: close$'
stdout '^Next: run "lyceum close"$'

-- TESTING.md --
---
lyceum: 1
suite: sh t.sh
test_files: ["*_test.sh"]
---

# TESTING.md
-- t.sh --
exit 0
-- a_test.sh --
exit 0
-- spec.txt --
spec
-- testing.txt --
testing
