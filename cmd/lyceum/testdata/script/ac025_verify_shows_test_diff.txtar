# AC25: given a refactor that passed baseline, when a test file's assertions change and the owner has not approved that diff, then verify does not clear and the diff is shown
cd $REPO
exec lyceum init
mkdir src
cp $WORK/TESTING.md TESTING.md
cp $WORK/t.sh t.sh
cp $WORK/calc.sh src/calc.sh
cp $WORK/calc_test.sh src/calc_test.sh
exec git add -A
exec git commit -q -m 'setup'
ttyin -stdin $WORK/testing.txt
exec sh -c 'lyceum approve testing >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'
exec lyceum refactor 'Tidy'
ttyin -stdin $WORK/intent.txt
exec sh -c 'lyceum approve intent >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

exec lyceum test
stdout '^Cleared baseline for 6ae678-tidy$'
ttyin -stdin $WORK/plan.txt
exec sh -c 'lyceum approve plan >/dev/tty; echo "exit=$?"'
stdout '^exit=0$'

cp $WORK/calc-tidy.sh src/calc.sh
cp $WORK/calc_test-edited.sh src/calc_test.sh
cp $WORK/new_test.sh src/new_test.sh
exec git add -A
exec git commit -q -m 'tidy, and tests changed'

exec lyceum test
stdout '^Not cleared: verify: these test files were changed or added since the baseline, and a test change in a refactor needs the owner''s approval: src/calc_test.sh, src/new_test.sh$'
stdout '^Changes since the fingerprint \(commit [0-9a-f]{7,}\):$'
stdout '^-\[ "\$\(add 1 2\)" = 3 \]'
stdout '^\+\[ "\$\(add 1 2\)" != 4 \]'
stdout '^New test file src/new_test.sh, not in commit [0-9a-f]{7,}, in full:$'
stdout '^# TestNew$'
! grep '"gate":"verify"' lyceum/events.jsonl

-- testing.txt --
testing
-- intent.txt --
intent
-- plan.txt --
plan
-- t.sh --
for f in src/*_test.sh; do sh "$f" || exit 1; done
-- calc.sh --
add() { echo $(($1 + $2)); }
-- calc-tidy.sh --
add() {
	echo $(($1 + $2))
}
-- calc_test.sh --
# TestAdd
. ./src/calc.sh
[ "$(add 1 2)" = 3 ] || { echo "--- FAIL: TestAdd"; exit 1; }
-- calc_test-edited.sh --
# TestAdd
. ./src/calc.sh
[ "$(add 1 2)" != 4 ] || { echo "--- FAIL: TestAdd"; exit 1; }
-- new_test.sh --
# TestNew
-- TESTING.md --
---
lyceum: 1
suite: sh ./t.sh
test_files: ["**/*_test.sh"]
subsets:
  changed: sh ./t.sh
---

# TESTING.md
