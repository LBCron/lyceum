# AC108: every refusal names a reason and at least one concrete next step
# Every command in the menu is built; each refusal below names its next step.
cd $REPO

# eject is built; here it refuses because stdin is not a terminal.
! exec lyceum eject
! stdout .
stderr '^Can''t eject: stdin and stdout must both be a terminal; eject is for the owner, typed in their own terminal$'
stderr '^Next: \S'
! exec lyceum eject --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

# status refuses in a repo Lyceum is not set up in.
! exec lyceum status
! stdout .
stderr '^Can''t show status: Lyceum is not set up in this repo: lyceum/config.yaml is missing$'
stderr '^Next: run "lyceum init"$'
! exec lyceum status --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

# check --ci refuses in a repo Lyceum is not set up in (locally it warns).
! exec lyceum check --ci
! stdout .
stderr '^Can''t check: Lyceum is not set up in this repo: lyceum/config.yaml is missing$'
stderr '^Next: run "lyceum init"$'
! exec lyceum check --ci --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

# approve refuses in a repo Lyceum is not set up in. approve answers only in a terminal,
#so stdin is the pty (ttyin -stdin) and stdout is sent to it too (/dev/tty); the
# terminal shows only the echoed Enter.
ttyrun $WORK/enter.txt 'lyceum approve'
stdout '^exit=2$'
! grep '\S' $WORK/tty.out
stderr '^Can''t approve: Lyceum is not set up in this repo: lyceum/config.yaml is missing$'
stderr '^Next: run "lyceum init"$'
ttyrun $WORK/enter.txt 'lyceum approve --json'
stdout '^exit=2$'
grep '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"].*\}\r?$' $WORK/tty.out
grep -count=1 '^.*\S' $WORK/tty.out
! stderr .

