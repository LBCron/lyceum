# export with no record refuses, naming the form.
! exec lyceum export
! stdout .
stderr '^Can''t export: export takes the record file and, optionally, the path to write under docs/$'
stderr '^Next: \S'
! exec lyceum export --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

# init refuses outside a git repo when no one answers its git init offer.
mkdir $WORK/plain
cd $WORK/plain
! exec lyceum init
! stdout .
stderr '^Can''t set up Lyceum here: this is not a git repository$'
stderr '^Next: \S'
! exec lyceum init --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'

# add refuses outside a git repo.
! exec lyceum add feat 'CSV export'
! stdout .
stderr '^Can''t add a unit: this is not a git repository, so Lyceum is not set up here$'
stderr '^Next: run "lyceum init"$'

# check refuses outside a git repo.
! exec lyceum check --ci
! stdout .
stderr '^Can''t check: this is not a git repository, so Lyceum is not set up here$'
stderr '^Next: run "lyceum init"$'

-- enter.txt --

