# add refuses without a type or a title, and in a repo Lyceum is not set up in.
! exec lyceum add
! stdout .
stderr '^Can''t add a unit: no unit type given; the types are feat, bug, doc and test$'
stderr '^Next: \S'
! exec lyceum add --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

! exec lyceum add nope
! stdout .
stderr '^Can''t add a unit: unknown unit type "nope"; the types are feat, bug, doc and test$'
stderr '^Next: \S'

! exec lyceum add feat
! stdout .
stderr '^Can''t add a unit: no title given$'
stderr '^Next: run lyceum add feat "<title>"$'
! exec lyceum add feat --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

! exec lyceum add bug CSV export
! stdout .
stderr '^Can''t add a unit: the title must be one argument$'
stderr '^Next: quote the title: lyceum add bug "CSV export"$'

! exec lyceum add doc '!!!'
! stdout .
stderr '^Can''t add a unit: title "!!!" has no letters or digits to make a slug from$'
stderr '^Next: \S'

! exec lyceum add test 'Empty export'
! stdout .
stderr '^Can''t add a unit: Lyceum is not set up in this repo: lyceum/config.yaml is missing$'
stderr '^Next: run "lyceum init"$'
! exec lyceum add test 'Empty export' --json
jsonobject
stdout '^\{"ok":false,"refusal":\{"reason":"[^"]+","next":\["[^"]'
! stderr .

