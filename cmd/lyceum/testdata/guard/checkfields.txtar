# Guard checkfields: with the CLI-owned field check off, the attack of ac017_cli_field_tamper.txtar passes check --ci.
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'

# gate: hand-edited from spec to build.
exec sh -c 'sed "s/^gate: spec$/gate: build/" lyceum/plan/6ae678-csv-export.md > plan.tmp && mv plan.tmp lyceum/plan/6ae678-csv-export.md'
grep '^gate: build$' lyceum/plan/6ae678-csv-export.md
exec lyceum check --ci
stdout '^No findings$'
! stderr .
