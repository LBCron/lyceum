# Guard checkgate: with the gate-before-code check off, the attack of ac047_code_before_gate.txtar passes check --ci.
cd $REPO
exec lyceum init
exec git add -A
exec git commit -q -m 'lyceum init'
exec lyceum add feat 'CSV export'

# Code committed at gate spec: only the scope warning is left, which does not fail check --ci.
mkdir src
cp $WORK/a.go src/a.go
exec git add src/a.go
exec git commit -q -m 'code before the spec gate'
exec lyceum check --ci
stdout '^warn: scope: '
! stdout '^fail:'
! stderr .

-- a.go --
package a
